{
  "name": "pi-dent-terms",
  "version": "0.1.0",
  "description": "A pi extension that manages a workspace's terms file and checks its Markdown against it",
  "keywords": [
    "glossary",
    "markdown",
    "pi-extension",
    "pi-package",
    "terminology"
  ],
  "homepage": "https://github.com/dralban68/pi-dent-terms#readme",
  "bugs": "https://github.com/dralban68/pi-dent-terms/issues",
  "license": "MIT",
  "author": "Chris B <dralban68@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dralban68/pi-dent-terms.git"
  },
  "files": [
    "index.ts",
    "lib/"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test --test-timeout=30000 test/",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-table": "^2.0.1",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-util-decode-string": "^2.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.93.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
